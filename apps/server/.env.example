KIMI_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
QWEN_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

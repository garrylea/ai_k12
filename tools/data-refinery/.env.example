# MinerU
MINERU_BIN=mineru-open-api
MINERU_TIMEOUT=300
MINERU_TOKEN=your-mineru-token

# LLM（OpenAI 兼容；provider 支持 openai/kimi/qwen/glm/deepseek/gemini/local/anthropic）
# local = 本地 llama.cpp server，如 LLM_BASE_URL=http://192.168.1.8:12345/v1
# anthropic = Anthropic 兼容端点（anthropic SDK 路径）
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
# 鉴权：优先 LLM_AUTH_TOKEN（refinery 专属，勿用 ANTHROPIC_* 会被 shell 里 Claude Code 覆盖）；
# fallback 链 LLM_API_KEY -> OPENAI_API_KEY -> ANTHROPIC_API_KEY；token：LLM_AUTH_TOKEN -> ANTHROPIC_AUTH_TOKEN
LLM_AUTH_TOKEN=sk-...
LLM_BASE_URL=
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=16384
# thinking 开关（默认关）；开启时 JSON 模式自动降级为纯文本由下游解析
LLM_THINKING=false
# 显式缓存开关（默认关；OpenAI 兼容端点多为自动前缀缓存，此开关主要作用于 anthropic 端点）
LLM_ENABLE_CACHE=false

# MySQL（db_loader 用；需先用 tools/db/install_mysql.sh 初始化）
DB_HOST=localhost
DB_PORT=3306
DB_USER=ai_k12
DB_PASS=ai_k12
DB_NAME=ai_k12

# 路径覆盖（可选）
# REFINERY_INPUT_DIR=tools/crawler/data          # convert 的素材输入目录（默认）
# REFINERY_OUTPUT_DIR=tools/data-refinery/output # 输出根：md/extracted/toc/published 都在其下（默认）
